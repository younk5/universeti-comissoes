{
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently \"node --env-file-if-exists=.env --watch server.js\" \"vite --host 127.0.0.1\"",
    "start": "node server.js",
    "build": "vite build",
    "test": "node --test tests/unit/*.test.js tests/api/*.test.js",
    "check": "node --check src/server/config.js && node --check src/server/supabase-admin.js && node --check src/server/vercel-app.js && npm run check:secrets",
    "check:secrets": "node scripts/assert-no-secrets.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "supertest": "^7.2.2",
    "vite": "^8.2.2"
  }
}
